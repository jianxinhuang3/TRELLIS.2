{
    "models": {
        "denoiser": {
            "name": "InjectedSparseStructureFlowModel",
            "args": {
                "pretrained_base": "/data5/jianxin/TRELLIS.2/weights/TRELLIS.2-4B/ckpts/ss_flow_img_dit_1_3B_64_bf16",
                "injector_args": {
                    "gate_init": 1.0
                }
            }
        }
    },
    "dataset": {
        "name": "SkylinesSSLatent",
        "args": {
            "repeat": 1000,
            "image_size": 512,
            "min_aesthetic_score": 4.5,
            "pretrained_ss_dec": "/data5/jianxin/TRELLIS.2/weights/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16"
        }
    },
    "trainer": {
        "name": "GeoImageConditionedFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 10000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 5e-4,
                    "weight_decay": 0.01,
                    "betas": [0.9, 0.95],
                    "eps": 1e-8
                }
            },
            "ema_rate": [
                0.9999
            ],
            "mix_precision_mode": "amp",
            "mix_precision_dtype": "bfloat16",
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 5.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 50,
            "i_sample": 10000,
            "i_save": 2000,
            "p_uncond": 0.1,
            "p_uncond_geo": 0.1,
            "t_schedule": {
                "name": "uniform",
                "args": {}
            },
            "sigma_min": 1e-5,
            "image_cond_model": {
                "name": "DinoV3FeatureExtractor",
                "args": {
                    "model_name": "/data5/jianxin/TRELLIS.2/weights/dinov3-vitl16",
                    "image_size": 512
                }
            },
            "geo_cond_model": {
                "pretrained": "/data5/jianxin/TRELLIS.2/weights/TRELLIS-image-large/ckpts/ss_enc_conv3d_16l8_fp16"
            }
        }
    }
}
